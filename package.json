{
  "name": "project-bolt-micro-sites",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-once.mjs",
    "validate": "node scripts/validate-cloudflare-token.mjs",
    "diagnose": "node scripts/diagnose-sites.mjs",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:flooring": "node scripts/deploy-cloudflare.mjs flooringboxcalculator --attach-domain",
    "deploy:satoshi": "node scripts/deploy-cloudflare.mjs project --attach-domain",
    "analytics:setup": "node scripts/setup-google-analytics.mjs",
    "deploy:paint": "node scripts/deploy-cloudflare.mjs paintcalculator --attach-domain",
    "deploy:mulch": "node scripts/deploy-cloudflare.mjs mulchcalculator --attach-domain",
    "deploy:drywall": "node scripts/deploy-cloudflare.mjs drywallcalculator --attach-domain",
    "deploy:hvac": "node scripts/deploy-cloudflare.mjs hvaccalculator --attach-domain",
    "deploy:landscape": "node scripts/deploy-cloudflare.mjs landscapetoolsguide --attach-domain",
    "deploy:metabolic": "node scripts/deploy-cloudflare.mjs metaboliclowcarb --attach-domain",
    "domain": "node scripts/setup-cloudflare-domain.mjs",
    "redirects:www": "node scripts/setup-www-redirects.mjs",
    "redirects:check": "node scripts/check-redirect-permissions.mjs",
    "google:verify": "node scripts/add-google-verification.mjs",
    "sitemaps:ping": "node scripts/ping-sitemaps.mjs --all",
